{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noImplicitAny": false,
    "strictNullChecks": false
  },
  // TODO(next-patch): Next 16.3.7 ships with a types/ dir referenced by
  // index.d.ts but missing from the tarball (types/global.d.ts,
  // types/compiled.d.ts). Remove this file once the types fix lands.
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"]
}